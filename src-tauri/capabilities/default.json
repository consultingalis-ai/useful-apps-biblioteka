{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Dozvole za glavni prozor: samo ono što aplikacija stvarno koristi.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "clipboard-manager:allow-write-text",
    "dialog:allow-save",
    "dialog:allow-open",
    "log:default",
    "core:window:allow-destroy"
  ]
}
