{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biblioteka promptova",
  "mainBinaryName": "biblioteka-promptova",
  "version": "../package.json",
  "identifier": "rs.dusan.biblioteka-promptova",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Biblioteka promptova",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxODc5OTIwMjg0RjRFQ0EKUldUS1RrOG9JSm1IY1NTb1R5OER4M0ZRd1Y2NlY4Sk53T0lkdnFEWEJLOGttYTRFMzlMV2hxRkoK",
      "endpoints": [
        "https://github.com/consultingalis-ai/useful-apps-biblioteka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
